{
  "name": "cosmoscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "3D solar system with ephemeris-driven orbits, NASA fact sheet data and live NASA feeds",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test test/*.test.mjs",
    "textures": "node tools/render-textures.mjs",
    "textures:fetch": "node tools/fetch-textures.mjs",
    "textures:check": "node tools/check-textures.mjs",
    "test:browser": "playwright test",
    "test:ui": "node --test test/ui/*.test.mjs",
    "vendor": "node tools/vendor.mjs",
    "missions:fetch": "node tools/fetch-missions.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "astronomy-engine": "^2.1.19",
    "jsdom": "^30.1.3",
    "three": "^0.170.0"
  }
}
